---
import type { SiteSettings } from '../lib/defaultData';

interface Props {
  currentPath?: string;
  settings: SiteSettings;
  transparent?: boolean;
}

const { currentPath = '/', settings, transparent = false } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/services', label: 'Services' },
  { href: '/accommodation', label: 'Accommodation' },
  { href: '/schedule-tour', label: 'Schedule a Tour' },
  { href: '/contact', label: 'Contact' },
  { href: '/faq', label: 'FAQ' },
];

const cleanCurrentPath = currentPath.replace(/\/index\.html$/, '').replace(/\.html$/, '') || '/';
---

<!-- Skip Link -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- ─── Navbar ─────────────────────────────────────────────── -->
<nav
  class={`navbar ${transparent ? 'navbar--transparent' : 'navbar--solid'}`}
  id="navbar"
  data-transparent={transparent ? "true" : "false"}
  role="navigation"
  aria-label="Main navigation"
>
  <div class="navbar__inner">
    <a href="/" class="navbar__logo" aria-label={`${settings.name} - Home`}>
      <img src="/images/logo.png" alt={settings.name} class="navbar__logo-img" width="130" height="48" />
    </a>
    <nav class="navbar__nav" aria-label="Site navigation">
      {navLinks.map((link) => {
        const isActive = cleanCurrentPath === link.href || (link.href !== '/' && cleanCurrentPath.startsWith(link.href));
        return (
          <a href={link.href} class={isActive ? 'active' : ''}>
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="navbar__actions">
      <a href={`tel:${settings.phoneTel}`} class="navbar__call-btn" aria-label={`Call us at ${settings.phone}`}>
        <span class="call-icon" aria-hidden="true">📞</span>
        <span class="call-text">{settings.phone}</span>
      </a>
      <a href="/schedule-tour" class="btn btn--primary btn--sm navbar__tour-btn">Schedule Tour</a>
      <button class="navbar__toggle" id="mobileToggle" aria-label="Toggle mobile menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Nav -->
<div class="mobile-nav" id="mobileNav" role="dialog" aria-label="Mobile navigation">
  {navLinks.map((link) => {
    const isActive = cleanCurrentPath === link.href || (link.href !== '/' && cleanCurrentPath.startsWith(link.href));
    return (
      <a href={link.href} class={isActive ? 'active' : ''}>
        {link.label}
      </a>
    );
  })}
  <div class="mobile-nav__actions">
    <a href={`tel:${settings.phoneTel}`} class="btn btn--primary">📞 Call {settings.phone}</a>
    <a href="/schedule-tour" class="btn btn--navy" style="margin-top:0.75rem;">🏠 Schedule a Tour</a>
  </div>
</div>
