---
import '../styles/main.css';
import '../styles/animations.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/sanity';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  transparentNav?: boolean;
}

const settings = await getSiteSettings();

const {
  title = `${settings.name} | Compassionate 24/7 Senior Care in Marysville, WA`,
  description = `${settings.name} provides compassionate, personalized 24/7 residential care for seniors in Marysville, Washington. Licensed Adult Family Home with 5 bedrooms. Schedule a tour today.`,
  canonicalPath = '/',
  ogImage = '/images/outside.jpg',
  transparentNav = false,
} = Astro.props;

const canonicalUrl = `https://www.sunriseafh.com${canonicalPath}`;
const currentPath = Astro.url.pathname;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["ResidentialFacility", "LocalBusiness", "MedicalBusiness"],
  "name": settings.name,
  "legalName": "Sunrise Adult Family Home LLC",
  "description": description,
  "url": "https://www.sunriseafh.com",
  "logo": "https://www.sunriseafh.com/logo.png",
  "image": "https://www.sunriseafh.com/images/outside.jpg",
  "telephone": settings.phoneTel,
  "email": settings.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": settings.streetAddress,
    "addressLocality": settings.city,
    "addressRegion": settings.state,
    "postalCode": settings.zip,
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 48.0518,
    "longitude": -122.1771
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "priceRange": "$$",
  "areaServed": [
    { "@type": "City", "name": "Marysville" },
    { "@type": "City", "name": "Everett" },
    { "@type": "City", "name": "Lake Stevens" },
    { "@type": "City", "name": "Arlington" },
    { "@type": "AdministrativeArea", "name": "Snohomish County" },
    { "@type": "State", "name": "Washington" }
  ],
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "24/7 Dedicated Care", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Private Bedrooms", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Wheelchair Accessible", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Home-Cooked Nutrition", "value": true }
  ],
  "sameAs": [
    settings.facebookUrl || "https://www.facebook.com/",
    settings.instagramUrl || "https://www.instagram.com/"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="Adult Family Home Washington, Senior Care Home Marysville WA, Residential Care Washington, 24 Hour Senior Care, Memory Care Home Washington, Adult Family Home Near Me, Assisted Living Alternative Washington">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>

  <!-- Geographic Local SEO -->
  <meta name="geo.region" content="US-WA">
  <meta name="geo.placename" content="Marysville, Washington">
  <meta name="geo.position" content="48.0518;-122.1771">
  <meta name="ICBM" content="48.0518, -122.1771">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://www.sunriseafh.com${ogImage}`}>
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://www.sunriseafh.com${ogImage}`}>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <meta name="theme-color" content="#163855">
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">
</head>
<body>

  <Navbar currentPath={currentPath} settings={settings} transparent={transparentNav} />

  <main id="main-content">
    <slot />
  </main>

  <Footer settings={settings} />

  <script is:inline src="/js/main.js"></script>
  <script is:inline src="/js/form.js"></script>
</body>
</html>
