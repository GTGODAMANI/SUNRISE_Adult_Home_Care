---
import Layout from '../layouts/Layout.astro';
import {
  getSiteSettings,
  getHero,
  getServices,
  getRooms,
  getGallery,
  getTestimonials,
  getFaqs,
} from '../lib/sanity';

const settings = await getSiteSettings();
const hero = await getHero();
const services = await getServices();
const rooms = await getRooms();
const gallery = await getGallery();
const testimonials = await getTestimonials();
const faqs = await getFaqs();
---

<Layout
  title={`${settings.name} | Compassionate 24/7 Senior Care in Marysville, WA`}
  description={`${settings.name} provides compassionate, personalized 24/7 residential care for seniors in Marysville, Washington. Licensed Adult Family Home with 5 bedrooms. Schedule a tour today.`}
  canonicalPath="/"
  transparentNav={true}
>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 1: HERO
  ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Hero section">
    <div
      class="hero__bg"
      role="img"
      aria-label="Warm residential home at sunrise"
      style={`background-image: url('${hero.bgImage}');`}
    ></div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__badge" aria-label="Licensed Adult Family Home in Washington State">
        {hero.badge}
      </div>
      <h1>
        {hero.titlePrefix}<span>{hero.titleHighlight}</span><br>
        {hero.titleSuffix}
      </h1>
      <p class="hero__sub">
        {hero.subtitle}
      </p>
      <div class="btn-group">
        <a href="/schedule-tour" class="btn btn--primary btn--lg" id="hero-tour-cta">
          🏠 Schedule a Tour
        </a>
        <a href="/contact" class="btn btn--secondary btn--lg" id="hero-contact-cta">
          Contact Us
        </a>
      </div>
      <div class="hero__stats" role="list" aria-label="Home statistics">
        {hero.stats.map((stat) => (
          <div class="hero__stat" role="listitem">
            <span class="stat-number">{stat.number}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
      <span>Scroll</span>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2: TRUST BAR
  ═══════════════════════════════════════════════════════ -->
  <section class="trust-bar" aria-label="Our credentials and commitments">
    <div class="container">
      <div class="trust-grid" role="list">
        <div class="trust-item reveal delay-1" role="listitem">
          <div class="trust-item__icon" aria-hidden="true">🏛️</div>
          <span>Licensed Adult Family Home</span>
        </div>
        <div class="trust-item reveal delay-2" role="listitem">
          <div class="trust-item__icon" aria-hidden="true">🕐</div>
          <span>24/7 Care &amp; Supervision</span>
        </div>
        <div class="trust-item reveal delay-3" role="listitem">
          <div class="trust-item__icon" aria-hidden="true">📋</div>
          <span>Personalized Care Plans</span>
        </div>
        <div class="trust-item reveal delay-4" role="listitem">
          <div class="trust-item__icon" aria-hidden="true">❤️</div>
          <span>Experienced Caregivers</span>
        </div>
        <div class="trust-item reveal delay-5" role="listitem">
          <div class="trust-item__icon" aria-hidden="true">🏠</div>
          <span>Safe Residential Setting</span>
        </div>
        <div class="trust-item reveal delay-6" role="listitem">
          <div class="trust-item__icon" aria-hidden="true">👨‍👩‍👧</div>
          <span>Family Communication &amp; Support</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 3: ABOUT
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="container">
      <div class="about-grid">
        <div class="about__image-wrapper reveal-left">
          <img
            src="/images/lobby.jpg"
            alt="Comfortable, sunlit living room and lounge at Sunrise AFH in Marysville, WA"
            loading="lazy"
            width="600"
            height="520"
          >
          <div class="about__badge" aria-label="Washington State Licensed facility">
            <span class="badge-icon" aria-hidden="true">⭐</span>
            <div class="badge-text">
              <strong>Washington State</strong>
              <span>Licensed &amp; Certified</span>
            </div>
          </div>
        </div>

        <div class="reveal-right">
          <span class="section-label">About {settings.shortName}</span>
          <h2 id="about-heading">A Place Where Care <em>Feels Like Family</em></h2>
          <p class="lead" style="margin-top:1rem;">
            At {settings.name}, we provide compassionate, individualized care in a comfortable residential setting in Marysville, Washington.
          </p>
          <p style="margin-top:1rem;">
            Our mission is to enhance the quality of life of every resident through respect, dignity, safety, and personalized support. Residents receive assistance tailored to their unique needs while enjoying the warmth and comfort of a home-like environment.
          </p>
          <p style="margin-top:1rem;">
            We believe that every person deserves to live with dignity, purpose, and joy — regardless of age or ability. Our dedicated team is committed to making that a reality for each and every resident.
          </p>
          <div class="about__values" aria-label="Our core values">
            <div class="about__value">Dignity &amp; Respect</div>
            <div class="about__value">Safety First</div>
            <div class="about__value">Personalized Care</div>
            <div class="about__value">Family-Centered</div>
            <div class="about__value">Compassionate Staff</div>
            <div class="about__value">Quality of Life</div>
          </div>
          <div class="btn-group" style="margin-top:2rem;">
            <a href="/about" class="btn btn--navy" id="about-learn-more">Learn More About Us</a>
            <a href="/schedule-tour" class="btn btn--outline-navy" id="about-tour-cta">Schedule a Tour</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 4: STATS
  ═══════════════════════════════════════════════════════ -->
  <section class="stats-section" aria-label="Our key statistics">
    <div class="container">
      <div class="stats-grid" role="list">
        <div class="stat-item reveal" role="listitem">
          <div class="stat-num">
            <span class="counter-num" data-target="5" data-suffix="">5</span>
          </div>
          <div class="stat-lbl">Private Bedrooms</div>
        </div>
        <div class="stat-item reveal delay-2" role="listitem">
          <div class="stat-num">24/7</div>
          <div class="stat-lbl">Care &amp; Supervision</div>
        </div>
        <div class="stat-item reveal delay-3" role="listitem">
          <div class="stat-num">
            <span class="counter-num" data-target={services.length} data-suffix="">{services.length}</span>
          </div>
          <div class="stat-lbl">Care Services Offered</div>
        </div>
        <div class="stat-item reveal delay-4" role="listitem">
          <div class="stat-num">100%</div>
          <div class="stat-lbl">Dedicated to Your Family</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 5: SERVICES
  ═══════════════════════════════════════════════════════ -->
  <section class="section section--gray" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What We Offer</span>
        <h2 id="services-heading">Comprehensive Care Services</h2>
        <p>We offer a full range of personalized care services designed to support your loved one's health, independence, and well-being.</p>
        <div class="section-divider" aria-hidden="true"></div>
      </div>

      <div class="services-grid">
        {services.map((service, index) => (
          <article class={`card card--service reveal delay-${(index % 6) + 1}`} id={service.id}>
            <div class="card__icon" aria-hidden="true">{service.icon}</div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href={`/services#${service.id}`} class="btn btn--outline-navy btn--sm" style="margin-top:1.5rem;">Learn More</a>
          </article>
        ))}
      </div>

      <div class="text-center" style="margin-top:3rem;">
        <a href="/services" class="btn btn--navy btn--lg" id="services-all-cta">View All Services</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 6: WHY CHOOSE US
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="why-us" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Why Families Choose Us</span>
        <h2 id="why-heading">Care You Can Trust, <em>Always</em></h2>
        <p>Families choose Sunrise Adult Family Home for our unwavering commitment to quality, compassion, and personalized care.</p>
        <div class="section-divider" aria-hidden="true"></div>
      </div>

      <div class="features-grid">
        <div class="feature-card reveal delay-1">
          <div class="feature-card__icon" aria-hidden="true">📋</div>
          <div class="feature-card__text">
            <h4>Personalized Care Plans</h4>
            <p>Every resident receives an individualized care plan developed in collaboration with families and healthcare providers.</p>
          </div>
        </div>
        <div class="feature-card reveal delay-2">
          <div class="feature-card__icon" aria-hidden="true">❤️</div>
          <div class="feature-card__text">
            <h4>Compassionate Staff</h4>
            <p>Our team is passionate, experienced, and treats every resident as a valued member of our extended family.</p>
          </div>
        </div>
        <div class="feature-card reveal delay-3">
          <div class="feature-card__icon" aria-hidden="true">🏠</div>
          <div class="feature-card__text">
            <h4>Safe &amp; Comfortable Home</h4>
            <p>A warm, clean, and safe residential environment designed for dignity, comfort, and peace of mind.</p>
          </div>
        </div>
        <div class="feature-card reveal delay-4">
          <div class="feature-card__icon" aria-hidden="true">👨‍👩‍👧</div>
          <div class="feature-card__text">
            <h4>Family-Focused Communication</h4>
            <p>Regular updates, open communication, and family involvement in care decisions every step of the way.</p>
          </div>
        </div>
        <div class="feature-card reveal delay-5">
          <div class="feature-card__icon" aria-hidden="true">🍽️</div>
          <div class="feature-card__text">
            <h4>Nutritious Home-Cooked Meals</h4>
            <p>Fresh, nutritious, home-cooked meals prepared daily, accommodating dietary needs and personal preferences.</p>
          </div>
        </div>
        <div class="feature-card reveal delay-6">
          <div class="feature-card__icon" aria-hidden="true">✨</div>
          <div class="feature-card__text">
            <h4>Clean &amp; Peaceful Environment</h4>
            <p>A meticulously maintained, tranquil home environment that promotes well-being and a sense of belonging.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 7: ACCOMMODATION
  ═══════════════════════════════════════════════════════ -->
  <section class="section section--gray" id="accommodation" aria-labelledby="accom-heading">
    <div class="container">
      <div class="accom-grid">
        <div class="reveal-left">
          <span class="section-label">Our Home</span>
          <h2 id="accom-heading">Comfortable Living Spaces</h2>
          <p class="lead" style="margin-top:1rem;">
            Our home offers comfortable private bedrooms, warm shared living areas, nutritious meals, and a peaceful environment designed to promote well-being and independence.
          </p>
          <p style="margin-top:1rem;">
            Every space in our home is thoughtfully designed to feel warm, homey, and dignified — a true home away from home.
          </p>

          <div class="accom-features" aria-label="Home features" style="margin-top:2rem;">
            <div class="accom-feature">
              <span class="icon" aria-hidden="true">🛏️</span>
              <span>5 Private Bedrooms</span>
            </div>
            <div class="accom-feature">
              <span class="icon" aria-hidden="true">🚿</span>
              <span>2 Bathrooms</span>
            </div>
            <div class="accom-feature">
              <span class="icon" aria-hidden="true">🛋️</span>
              <span>Shared Living Room</span>
            </div>
            <div class="accom-feature">
              <span class="icon" aria-hidden="true">🍽️</span>
              <span>Dining Area</span>
            </div>
            <div class="accom-feature">
              <span class="icon" aria-hidden="true">🌿</span>
              <span>Outdoor Space</span>
            </div>
            <div class="accom-feature">
              <span class="icon" aria-hidden="true">♿</span>
              <span>Accessible Design</span>
            </div>
          </div>

          <a href="/accommodation" class="btn btn--navy" style="margin-top:2rem;" id="accom-view-cta">View Accommodation Details</a>
        </div>

        <div class="gallery-grid reveal-right">
          <div
            class="gallery-item"
            data-lightbox="/images/dining.jpg"
            data-caption="Family-style dining area where residents enjoy nutritious home-cooked meals"
            role="button"
            tabindex="0"
            aria-label="View dining area - click to enlarge"
          >
            <img
              src="/images/dining.jpg"
              alt="Warm, inviting dining table with chairs for daily family-style meals"
              loading="lazy"
              width="580"
              height="300"
            >
            <div class="gallery-overlay" aria-hidden="true"><span>Family Dining Area</span></div>
          </div>

          <div
            class="gallery-item"
            data-lightbox="/images/bedroom.jpg"
            data-caption="Comfortable furnished private bedroom"
            role="button"
            tabindex="0"
            aria-label="View private bedroom - click to enlarge"
          >
            <img
              src="/images/bedroom.jpg"
              alt="Comfortable furnished private bedroom with made bed and natural light"
              loading="lazy"
              width="280"
              height="200"
            >
            <div class="gallery-overlay" aria-hidden="true"><span>Private Bedroom</span></div>
          </div>

          <div
            class="gallery-item"
            data-lightbox="/images/backyard.jpg"
            data-caption="Spacious green backyard and lawn"
            role="button"
            tabindex="0"
            aria-label="View backyard - click to enlarge"
          >
            <img
              src="/images/backyard.jpg"
              alt="Large fenced green lawn and backyard for fresh air and outdoor relaxation"
              loading="lazy"
              width="280"
              height="200"
            >
            <div class="gallery-overlay" aria-hidden="true"><span>Fenced Backyard</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 8: TESTIMONIALS
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="testimonials" aria-labelledby="test-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Family Testimonials</span>
        <h2 id="test-heading">What Families Are Saying</h2>
        <p>The trust of families who have chosen Sunrise AFH is our greatest honor.</p>
        <div class="section-divider" aria-hidden="true"></div>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((test, index) => (
          <article class={`testimonial-card reveal delay-${(index % 3) + 1}`}>
            <div class="stars" aria-label={`${test.rating} stars`}>
              {'⭐'.repeat(test.rating)}
            </div>
            <blockquote>
              "{test.quote}"
            </blockquote>
            <div class="testimonial-author">
              <div class="avatar" aria-hidden="true">
                {test.name.split(' ').map((n) => n[0]).join('')}
              </div>
              <div class="info">
                <strong>{test.name}</strong>
                <span>{test.relation}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 9: FAQ
  ═══════════════════════════════════════════════════════ -->
  <section class="section section--gray" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Common Questions</span>
        <h2 id="faq-heading">Frequently Asked Questions</h2>
        <p>Find answers to the most common questions families ask about our care home.</p>
        <div class="section-divider" aria-hidden="true"></div>
      </div>

      <div class="faq-list" role="list">
        {faqs.slice(0, 5).map((faq, index) => (
          <div class={`faq-item reveal delay-${(index % 5) + 1}`} role="listitem">
            <button class="faq-question" aria-expanded="false" id={`faq-q${index + 1}`} aria-controls={`faq-a${index + 1}`}>
              {faq.question}
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" id={`faq-a${index + 1}`} aria-labelledby={`faq-q${index + 1}`} role="region">
              <div class="faq-answer__inner">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center" style="margin-top:2.5rem;">
        <a href="/faq" class="btn btn--outline-navy" id="faq-all-cta">View All FAQs</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 10: SCHEDULE A TOUR
  ═══════════════════════════════════════════════════════ -->
  <section class="form-section" id="schedule-tour" aria-labelledby="tour-heading">
    <div class="container">
      <div class="form-grid">
        <div class="form-info reveal-left">
          <span class="section-label section-label--light">Schedule a Visit</span>
          <h2 id="tour-heading">Visit {settings.name}</h2>
          <p class="lead">
            We invite you to tour our home, meet our caregivers, and learn how we can support your loved one. Experience our warm, caring environment for yourself.
          </p>
          <div class="form-highlights">
            <div class="form-highlight">
              <div class="hl-icon" aria-hidden="true">🏠</div>
              <span>Tour our warm, home-like environment</span>
            </div>
            <div class="form-highlight">
              <div class="hl-icon" aria-hidden="true">👥</div>
              <span>Meet our experienced caregiving team</span>
            </div>
            <div class="form-highlight">
              <div class="hl-icon" aria-hidden="true">📋</div>
              <span>Discuss personalized care options</span>
            </div>
            <div class="form-highlight">
              <div class="hl-icon" aria-hidden="true">❓</div>
              <span>Get all your questions answered</span>
            </div>
          </div>
          <div style="margin-top:2.5rem; padding:1.5rem; background:rgba(255,255,255,0.08); border-radius:16px; border:1px solid rgba(255,255,255,0.12);">
            <p style="color:rgba(255,255,255,0.9); font-weight:600; margin-bottom:0.5rem;">Need to reach us right away?</p>
            <a href={`tel:${settings.phoneTel}`} class="btn btn--primary" id="tour-call-cta" style="margin-top:0.5rem;">
              📞 Call {settings.phone}
            </a>
          </div>
        </div>

        <div class="reveal-right">
          <div class="form-box">
            <h3>Request a Tour</h3>
            <p class="form-sub">Fill out the form and we'll contact you within 24 hours to confirm your visit.</p>

            <div id="tourSuccess" class="form-success" role="alert" aria-live="polite">
              <div class="success-icon" aria-hidden="true">🎉</div>
              <h3>Tour Request Received!</h3>
              <p>Thank you! We'll contact you within 24 hours to confirm your tour date. We look forward to welcoming you to {settings.shortName}.</p>
            </div>

            <form id="tourForm" novalidate aria-label="Schedule a tour request form">
              <div class="form-row">
                <div class="form-group">
                  <label for="tourFullName">Full Name <span class="required" aria-hidden="true">*</span></label>
                  <input
                    type="text"
                    id="tourFullName"
                    name="full_name"
                    placeholder="Your full name"
                    data-validate="required"
                    autocomplete="name"
                    aria-required="true"
                  >
                  <span class="form-error" role="alert"></span>
                </div>
                <div class="form-group">
                  <label for="tourPhone">Phone Number <span class="required" aria-hidden="true">*</span></label>
                  <input
                    type="tel"
                    id="tourPhone"
                    name="phone"
                    placeholder="(xxx) xxx-xxxx"
                    data-validate="required phone"
                    autocomplete="tel"
                    aria-required="true"
                  >
                  <span class="form-error" role="alert"></span>
                </div>
              </div>

              <div class="form-group">
                <label for="tourEmail">Email Address <span class="required" aria-hidden="true">*</span></label>
                <input
                  type="email"
                  id="tourEmail"
                  name="email"
                  placeholder="your@email.com"
                  data-validate="required email"
                  autocomplete="email"
                  aria-required="true"
                >
                <span class="form-error" role="alert"></span>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="tourResidentName">Resident's Name</label>
                  <input
                    type="text"
                    id="tourResidentName"
                    name="resident_name"
                    placeholder="Resident's name"
                    autocomplete="off"
                  >
                  <span class="form-error" role="alert"></span>
                </div>
                <div class="form-group">
                  <label for="tourDate">Preferred Tour Date <span class="required" aria-hidden="true">*</span></label>
                  <input
                    type="date"
                    id="tourDate"
                    name="preferred_date"
                    data-validate="required"
                    aria-required="true"
                  >
                  <span class="form-error" role="alert"></span>
                </div>
              </div>

              <div class="form-group">
                <label for="tourCareNeeds">Care Needs</label>
                <select id="tourCareNeeds" name="care_needs">
                  <option value="">Select primary care need</option>
                  <option value="Personal Care">Personal Care Assistance</option>
                  <option value="Medication Management">Medication Management</option>
                  <option value="Memory Care">Memory Care Support</option>
                  <option value="Respite Care">Respite Care</option>
                  <option value="Daily Living Support">Daily Living Support</option>
                  <option value="24-Hour Supervision">24-Hour Supervision</option>
                  <option value="Multiple Needs">Multiple Care Needs</option>
                </select>
                <span class="form-error" role="alert"></span>
              </div>

              <div class="form-group">
                <label for="tourMessage">Additional Notes or Questions</label>
                <textarea
                  id="tourMessage"
                  name="message"
                  placeholder="Tell us more about your loved one's needs, any questions you have, or anything else we should know..."
                  rows="4"
                ></textarea>
                <span class="form-error" role="alert"></span>
              </div>

              <!-- Honeypot -->
              <input type="text" name="_gotcha" style="display:none" tabindex="-1" aria-hidden="true">

              <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center;" id="tourSubmitBtn">
                🏠 Schedule My Tour
              </button>

              <p style="font-size:0.75rem;color:#94A3B8;text-align:center;margin-top:1rem;">
                By submitting, you agree to be contacted by {settings.name}. We respect your privacy and will never share your information.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 11: CONTACT
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="contact" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Get in Touch</span>
        <h2 id="contact-heading">Contact {settings.name}</h2>
        <p>We're here to answer your questions and help your family find the right care solution.</p>
        <div class="section-divider" aria-hidden="true"></div>
      </div>

      <div class="contact-grid">
        <div class="contact-info">
          <address style="font-style:normal;">
            <div class="contact-card">
              <div class="contact-card__icon" aria-hidden="true">📞</div>
              <div class="contact-card__info">
                <h4>Phone</h4>
                <a href={`tel:${settings.phoneTel}`} aria-label={`Call us at ${settings.phone}`}>{settings.phone}</a>
                <p style="font-size:0.8rem;color:#94A3B8;margin-top:4px;font-weight:400;">Available 24/7 for inquiries</p>
              </div>
            </div>

            <div class="contact-card">
              <div class="contact-card__icon" aria-hidden="true">✉️</div>
              <div class="contact-card__info">
                <h4>Email</h4>
                <a href={`mailto:${settings.email}`}>{settings.email}</a>
                <p style="font-size:0.8rem;color:#94A3B8;margin-top:4px;font-weight:400;">We respond within 24 hours</p>
              </div>
            </div>

            <div class="contact-card">
              <div class="contact-card__icon" aria-hidden="true">📍</div>
              <div class="contact-card__info">
                <h4>Address</h4>
                <p>{settings.streetAddress}<br>{settings.city}, {settings.state} {settings.zip}</p>
              </div>
            </div>

            <div class="contact-card">
              <div class="contact-card__icon" aria-hidden="true">🕐</div>
              <div class="contact-card__info">
                <h4>Care Hours</h4>
                <p>{settings.hours}</p>
              </div>
            </div>
          </address>
        </div>

        <div class="map-wrapper reveal-right">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2678.5!2d-122.177!3d48.052!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDjCsDAzJzA3LjIiTiAxMjLCsDEwJzM3LjIiVw!5e0!3m2!1sen!2sus!4v1600000000000!5m2!1sen!2sus"
            title={`${settings.name} location map — ${settings.address}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       CTA BANNER
  ═══════════════════════════════════════════════════════ -->
  <section class="cta-banner" aria-label="Call to action — schedule a tour">
    <div class="container" style="position:relative;z-index:1;">
      <span class="section-label" style="color:var(--navy-dark);background:rgba(31,78,121,0.15);">Take the First Step</span>
      <h2 style="margin-top:1rem;">Ready to Give Your Loved One<br>the Care They Deserve?</h2>
      <p>Schedule a tour today and experience the warmth of {settings.name} for yourself.</p>
      <div class="btn-group" style="justify-content:center;">
        <a href="/schedule-tour" class="btn btn--navy btn--lg" id="banner-tour-cta">🏠 Schedule a Tour</a>
        <a href={`tel:${settings.phoneTel}`} class="btn btn--outline-navy btn--lg" id="banner-call-cta">📞 Call {settings.phone}</a>
      </div>
    </div>
  </section>

</Layout>
